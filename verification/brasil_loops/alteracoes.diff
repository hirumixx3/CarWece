+        _ => 'ESPORTIVO',
+      };
+}
+
+List<int> filterCarCollection({
+  String performanceClass = 'TODAS',
+  String category = 'TODOS',
+  bool brazilOnly = false,
+}) => [
+  for (var i = 0; i < cars.length; i++)
+    if ((performanceClass == 'TODAS' ||
+            cars[i].performanceClass == performanceClass) &&
+        (category == 'TODOS' || cars[i].modelCategory == category) &&
+        (!brazilOnly || cars[i].id.startsWith('br_')))
+      i,
+];
