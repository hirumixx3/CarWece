+    final nowTracks = result['tracks'] as List,
+        beforeTracks = baseline['tracks'] as List;
+    for (var i = 0; i < 51; i++) {
+      if (nowTracks[i]['content'] != beforeTracks[i]['content'])
+        throw StateError('Old track physics changed: ${oldTracks[i].id}');
